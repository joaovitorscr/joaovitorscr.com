---
import Layout from "../layouts/Layout.astro";
import { site } from "../i18n/content";
---

<Layout locale="en" title={`Page not found — ${site.name}`} noindex>
	<main class="mx-auto flex min-h-svh max-w-6xl flex-col justify-center px-5 md:px-8">
		<p class="text-[15px] text-muted">404</p>
		<h1 class="mt-4 font-display text-5xl font-semibold tracking-[-0.04em] md:text-7xl">This page doesn't exist.</h1>
		<p class="mt-8 flex gap-6 text-[15px]">
			<a href="/en" class="text-link underline decoration-1 underline-offset-4 hover:decoration-2">Home</a>
			<a href="/pt" class="text-link underline decoration-1 underline-offset-4 hover:decoration-2">Início</a>
			<a href="/es" class="text-link underline decoration-1 underline-offset-4 hover:decoration-2">Inicio</a>
		</p>
	</main>
</Layout>
